# Django Core Settings
DEBUG=False
SECRET_KEY=generate-a-long-random-string-here
DJANGO_SETTINGS_MODULE=backend.settings_production

# Allowed Hosts (comma-separated, e.g., your-app.onrender.com)
ALLOWED_HOSTS=*

# Database Configuration (Render/Railway will provide this)
DATABASE_URL=postgres://user:password@host:port/dbname

# Security Settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# CORS & Frontend Integration
# Update this with your Vercel URL
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_URL=https://your-backend.onrender.com

# Payment Integration (Tap)
TAP_API_KEY=sk_test_RTYqGXHVj51DWLJkyKsxo6in
TAP_API_URL=https://api.tap.company/v2

# Optional: Redis (for caching)
# REDIS_URL=redis://your-redis-url

# Optional: Email Settings
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
