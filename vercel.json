{
    "redirects": [
        {
            "source": "/",
            "destination": "/LMSfrontend",
            "permanent": true
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "https://sla-delta-hazel.vercel.app/api/$1"
        },
        {
            "src": "/static/(.*)",
            "dest": "https://sla-delta-hazel.vercel.app/static/$1"
        },
        {
            "src": "/media/(.*)",
            "dest": "https://sla-delta-hazel.vercel.app/media/$1"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/((?!api|static|media).*)",
            "dest": "/index.html"
        }
    ]
}