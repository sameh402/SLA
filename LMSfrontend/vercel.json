{
    "cleanUrls": true,
    "trailingSlash": false,
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "https://sla-delta-hazel.vercel.app/api/$1"
        },
        {
            "src": "/static/(.*)",
            "dest": "https://sla-delta-hazel.vercel.app/static/$1"
        },
        {
            "src": "/media/(.*)",
            "dest": "https://sla-delta-hazel.vercel.app/media/$1"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cross-Origin-Embedder-Policy",
                    "value": "credentialless"
                },
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin"
                }
            ]
        }
    ]
}