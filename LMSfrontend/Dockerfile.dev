# Development Dockerfile for React/Vite
FROM node:20-bookworm-slim

WORKDIR /app

# Install dependencies
COPY package.json ./
RUN npm install --no-package-lock

# Copy source code
COPY . .

# Expose port
EXPOSE 8080

# Start development server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "8080"]
